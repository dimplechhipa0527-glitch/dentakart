generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  phone         String?
  role          String         @default("DOCTOR") // DOCTOR, ADMIN
  status        String         @default("ACTIVE") // ACTIVE, PENDING, BLOCKED
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  doctorProfile DoctorProfile?
  addresses     Address[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
}

model DoctorProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicName    String
  gstNumber     String?
  regNumber     String?   // Dental Council Registration No.
  clinicPhone   String?
  clinicEmail   String?
  addressLine   String?
  city          String?
  state         String?
  pincode       String?
  totalSpent    Float     @default(0)
  orderCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  icon         String?    // Lucide icon name or emoji
  description  String?
  parentId     String?
  parent       Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[] @relation("SubCategories")
  displayOrder Int        @default(0)
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Product {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  brand              String
  sku                String         @unique
  hsnCode            String         @default("9018")
  description        String
  specifications     String         // JSON stringified key-value specs
  price              Float
  mrp                Float
  discount           Float          @default(0)
  gstPercent         Float          @default(12) // 5, 12, 18%
  stock              Int            @default(0)
  lowStockThreshold  Int            @default(10)
  packSize           String
  manufacturer       String?
  expiryInfo         String?
  isFeatured         Boolean        @default(false)
  isBestseller       Boolean        @default(false)
  isActive           Boolean        @default(true)
  images             String         // JSON stringified array of image URLs
  categoryId         String
  category           Category       @relation(fields: [categoryId], references: [id])
  orderItems         OrderItem[]
  reviews            Review[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  inventoryLogs      InventoryLog[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   @default("SHIPPING") // SHIPPING, BILLING
  name         String
  clinicName   String?
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  gstNumber    String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id             String           @id @default(cuid())
  orderNumber    String           @unique
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  status         String           @default("PLACED") // PLACED, CONFIRMED, PROCESSING, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RETURN_REQUESTED, RETURNED
  subtotal       Float
  gstAmount      Float
  discountAmount Float            @default(0)
  shippingFee    Float            @default(0)
  totalAmount    Float
  paymentStatus  String           @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  paymentMethod  String           @default("UPI")     // UPI, CARD, NETBANKING, RAZORPAY, COD
  transactionId  String?
  trackingNumber String?
  courierName    String?
  shippingAddress String          // JSON string of shipping address
  billingAddress  String          // JSON string of billing address
  couponCode     String?
  doctorNotes    String?
  adminNotes     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items          OrderItem[]
  statusLogs     OrderStatusLog[]
  invoice        Invoice?
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  brand       String
  sku         String
  price       Float
  mrp         Float
  gstPercent  Float
  quantity    Int
  total       Float
}

model OrderStatusLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  updatedBy String?
  createdAt DateTime @default(now())
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceDate    DateTime @default(now())
  subtotal       Float
  gstAmount      Float
  discountAmount Float
  shippingFee    Float
  totalAmount    Float
  clinicName     String
  doctorName     String
  gstNumber      String?
  clinicAddress  String
  createdAt      DateTime @default(now())
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String
  discountType   String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue  Float
  minOrderValue  Float     @default(0)
  maxDiscount    Float?
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  usageLimit     Int?
  usageCount     Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorName String
  clinicName String?
  rating     Int      @default(5)
  title      String?
  comment    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model InventoryLog {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  previousStock  Int
  newStock       Int
  changeQuantity Int
  changeType     String   // RESTOCK, ORDER_DEDUCTION, MANUAL_ADJUSTMENT, RETURN_RESTOCK
  reason         String?
  adminName      String?
  createdAt      DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("ORDER") // ORDER, STOCK, PROMO, SYSTEM
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}
